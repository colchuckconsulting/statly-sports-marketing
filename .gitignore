# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

/certificates

# next.js
/.next/
/out/

# production
/build

# python
*.pyc

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bash script
.zshrc

# Terraform
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore any .tfvars files that are automatically generated
*.auto.tfvars

# Ignore override files as they are usually used to override resources locally and should not be committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration file
.terraformrc

# Ignore .terraform.lock.hcl file generated by Terraform v0.15+
.terraform.lock.hcl

# Ignore .tfplan files
*.tfplan

# Ignore .tfstate backups
*.backup

# Ignore .terraform files generated by Visual Studio Code extension
.terraform/

# Ignore any .tfplan files that might be created
*.tfplan

# Ignore any .terraform directories
.terraform/

# Ignore secrets file
/terraform/secrets/*.tfvars

.env